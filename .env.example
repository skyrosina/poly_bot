# Wallet / CLOB V2 authentication
PRIVATE_KEY=
SIGNATURE_TYPE=3
FUNDER_ADDRESS=

# Optional aliases
DEPOSIT_WALLET_ADDRESS=
SAFE_ADDRESS=

# Optional L2 API credentials. Leave all blank unless you already have all 3.
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=

CLOB_API_URL=https://clob.polymarket.com
CHAIN_ID=137

# Start safe
DRY_RUN=true
CHECK_GEOBLOCK=true
USE_TOR=false
LIVE_SAFE_MODE=true

# Strategy
MIN_EDGE=0.10
MIN_PROB=0.90
SAFETY_FACTOR=0.85
MIN_BTC_DELTA=0.10
ENTRY_WINDOW_START=25
ENTRY_WINDOW_END=10
ENTRY_CONFIRM_SECONDS=2.0
KELLY_FRACTION=0.10
MIN_BET=5.0
MAX_BET=5.0
BANKROLL=100.0

# Safety
DAILY_LOSS_LIMIT=5.0
VOL_FLOOR=0.12
VOL_CAP=0.30
ROLLING_VOL_WINDOWS=12
PRICE_REFRESH_SECONDS=2.0

# Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Other
MARKET_PERIOD=5
LOG_DIR=logs
LOG_EXECUTIONS=false
